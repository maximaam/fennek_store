{% extends 'base.html.twig' %}

{% block title %}
    {{ category.name(app.request.locale) }} -
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <aside class="col-md-3 sidebar">
                <div class="sidebar-header">
                    {% set subCatMenu = knp_menu_get('subCategory') %}
                    {{ knp_menu_render(subCatMenu) }}
                </div>
                <blockquote class="cat-desc">
                    {% if category.parent == null %}
                        <i class="fa fa-quote-right"></i>
                        <p>{{ category.description(app.request.locale)|nl2br }}</p>
                    {% endif %}
                </blockquote>
            </aside>

            <div class="col-md-9">
                {% if products|length == 0 %}
                    <div class="alert alert-warning">
                        {{ 'flashes.no_products_in_category'|trans }}
                    </div>
                {% else %}
                    <div class="row">
                        <h1>{{ category.name(app.request.locale) }}</h1>
                        {% for product in products %}
                            {% include 'partials/_product_card.html.twig' with {product: product, card_size: 4, img_filter: 'medium'} %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
