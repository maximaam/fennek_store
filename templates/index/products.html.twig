{% extends 'base.html.twig' %}

{% block title %}
    {{ category.name }} -
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <aside class="col-md-3 sidebar">
                <div class="sidebar-header">
                    {% include 'partials/_sub_categories.html.twig' %}
                </div>
                <div class="sidebar-header-mobile">
                    {% include 'partials/_sub_categories_mobile.html.twig' %}
                </div>
                <blockquote class="cat-desc">
                    {% if sub_categories != null and category.description != null %}
                        <i class="fa fa-quote-right"></i>
                        <p>{{ category.description|nl2br }}</p>
                    {% endif %}
                </blockquote>
            </aside>

            <div class="col-md-9">
                {% if products|length == 0 %}
                    <div class="alert alert-warning">
                        {{ 'flashes.no_products_in_category'|trans }}
                    </div>
                {% else %}
                    <div class="row">
                        <h1>{{ category.name }}</h1>
                        {% for product in products %}
                            {% include 'partials/_product_card.html.twig' with {product: product, category: category, card_size: 4, img_filter: 'medium'} %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
