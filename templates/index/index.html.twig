{% extends 'base.html.twig' %}

{% block body %}
    <div class="start-page">
        <div class="container">
            <div class="intro">
                <h1 class="display-4">{{ 'label.welcome.title'|trans }}</h1>
                <h2>{{ 'label.welcome.sub-title'|trans }}</h2>
            </div>
        </div>
        <div class="container">
            <div class="row">
                {% for product in products %}
                    {% include 'partials/_product_card.html.twig' with {product: product, isHomepage: true} %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="container start-seo">
        <h2>{{ 'label.about_us'|trans }}</h2>
        <p>{{ 'label.welcome.desc'|trans|nl2br }}</p>
        <p>
            <a class="btn btn-primary btn-lg" href="{{ path('app_index_page', {alias: 'routes.about_us'|trans}) }}" role="button">
                {{ 'label.more'|trans }} »
            </a>
        </p>
    </div>

{% endblock %}
