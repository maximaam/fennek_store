{% extends 'base.html.twig' %}

{% block title %}{{ 'label.login'|trans }}{% endblock %}

{% block body %}
    <div style="max-width: 360px; margin: 4rem auto;">
        <h1>{{ 'label.login'|trans }}</h1>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div>
                <label for="username">Username</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" required autofocus>
            </div>

            <div style="margin-top: 1rem;">
                <label for="password">Password</label>
                <input type="password" id="password" name="_password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button style="margin-top: 1.5rem;" type="submit">
                {{ 'label.login'|trans }}
            </button>
        </form>
    </div>
{% endblock %}
