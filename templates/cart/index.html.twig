{% extends 'base.html.twig' %}

{% set locale = app.request.attributes.get('_locale') %}

{% block js_head %}
    <script src="https://www.paypal.com/sdk/js?client-id={{ paypal_client_id }}&currency=EUR&disable-funding=card"></script>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            {% if cart is not defined or cart|length <= 0  %}
                <div class="alert alert-warning">
                    {{ 'cart.empty'|trans }}
                </div>
            {% else %}
                {% include 'partials/_products_table.html.twig' with {
                    'products': cart.products,
                    'totals': cart.totals,
                    'origin': 'cart',
                    'h1_title': 'cart.my_cart'|trans
                } %}
            {% endif %}
        </div>
    </div>

{% endblock %}
