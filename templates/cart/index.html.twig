{% extends 'base.html.twig' %}

{% set locale = app.request.attributes.get('_locale') %}

{% block js_head %}
    <script src="https://www.paypal.com/sdk/js?client-id={{ paypal_client_id }}&currency=EUR&disable-funding=card"></script>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">

            {% if cart is not defined or cart|length <= 0  %}
                <div class="alert alert-warning">
                    {{ 'cart.empty'|trans }}
                </div>
            {% endif %}

            {% set products = cart.products %}
            {% set totals = cart.totals %}
            <div class="table-responsive">
                <h1 class="text-center">{{ 'cart.my_cart'|trans }}</h1>
                <table class="table table-stripped">
                    <thead>
                    <tr>
                        <th></th>
                        <th>{{ 'product.singular'|trans }}</th>
                        <th>{{ 'product.item_number'|trans }}</th>
                        <th>{{ 'product.color'|trans }}</th>
                        <th>{{ 'product.size'|trans }}</th>
                        <th>{{ 'product.quantity'|trans }}</th>
                        <th>{{ 'purchase.price_unit'|trans }}</th>
                        <th>{{ 'purchase.price_total'|trans }}</th>
                        <th></th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for itemKey,product in products %}
                        <tr>
                            <td><img src="{{ asset('uploads/images/' ~ product.image) | imagine_filter('product_thumbnail') }}" alt="" width="120"></td>
                            <td><a href="{{ product.item_url }}">{{ product.title }}</a></td>
                            <td>{{ product.item_number }}</td>
                            <td>{{ ('product.colors_list.' ~ product.color)|trans }}</td>
                            <td>{{ product.size|length > 0 ? product.size : '-' }}</td>
                            <td>{{ product.quantity }}</td>
                            <td>{{ (product.price / 100)|format_currency('EUR') }}</td>
                            <td>{{ (product.full_price / 100)|format_currency('EUR') }}</td>
                            <td>
                                <a href="{{ path('app_cart_remove', {'itemKey': itemKey}) }}" title="{{ 'label.delete'|trans }}" rel="nofollow" class="btn btn-danger">
                                    {{ ea_ux_icon('bi:trash-fill', {class: 'basic-icon'}) }}
                                </a>
                            </td>
                        </tr>
                        {% if product.message is not empty %}
                        <tr>
                            <td colspan="9" style="background-color: #dee2e6">
                                {{ product.message }}
                            </td>
                        </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="7"></td>
                            <td class="font-weight-bold">{{ 'purchase.total_excl_tax'|trans }}</td>
                            <td>{{ (totals.excl_tax / 100)|format_currency('EUR') }}</td>
                        </tr>
                        <tr>
                            <td colspan="7"></td>
                            <td class="font-weight-bold">{{ 'purchase.vat'|trans }}</td>
                            <td>{{ (totals.vat / 100)|format_currency('EUR') }}</td>
                        </tr>
                        <tr>
                            <td colspan="7"></td>
                            <td class="font-weight-bold">{{ 'purchase.total_incl_tax'|trans }}</td>
                            <td>{{ (totals.total / 100)|format_currency('EUR') }}</td>
                        </tr>
                    <tr>
                        <td colspan="7">
                            <a href="{{ path('app_index_index') }}">
                                {{ 'cart.continue_shopping'|trans }}
                            </a>
                        </td>
                        <td colspan="2">
                            <div id="paypal-button-container"></div>
                            <script>
                                const locale = '{{ app.request.locale }}';
                                paypal.Buttons({
                                    createOrder: () => {
                                        return fetch('{{ path("app_purchase_create") }}', {
                                            method: 'POST'
                                        })
                                            .then(res => res.json())
                                            .then(data => data.id);
                                    },
                                    onApprove: (data) => {
                                        const orderId = data.orderID;
                                        return fetch(`/${locale}/purchase/capture/${orderId}`, {
                                            method: 'POST'
                                        })
                                            .then(res => res.json())
                                            .then(() => {
                                                console.log('Payment successful!');
                                                window.location.href = `/${locale}/purchase/complete/${orderId}`;
                                            });
                                    }
                                }).render('#paypal-button-container');
                            </script>
                        </td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

{% endblock %}
