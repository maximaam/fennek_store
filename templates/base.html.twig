<!DOCTYPE html>
<html lang="{{ app.request.locale }}">

{% set title = app_name %}

<head>
    <meta charset="utf-8">
    <title>{% block title %}{{ title }}!{% endblock %}</title>

    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="keywords" content="Fennek-Store, lederwaren, Sommerwaren, Winterwaren, Kopfbedeckung, Berlin">
    <meta name="description" content="Lederwaren, Saisonwaren & Geschenkartikel in Berlin.">
    <meta name="robots" content="index,follow">
    <meta name="author" content="{{ app_name }}">
    <meta name="title" content="{{ title }}!">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://{{ app.request.host ~ app.request.pathInfo }}">
    <meta property="og:title" content="{{ title }}!">
    <meta property="og:description" content="Lederwaren, Saisonwaren & Geschenkartikel in Berlin.">

    <link href="https://{{ app.request.host ~ app.request.pathInfo }}" rel="canonical">
    <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon.png') }}" />

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% block js_head %}
    {% endblock %}
</head>

<body>
    <header class="main-header">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/de">
                <img src="{{ asset('images/logo.webp') }}" alt="{{ app_name }} Logo" title="{{ app_name }}" width="40" height="40" class="logo rounded-circle">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                {{ knp_menu_render('main') }}
                <form class="d-flex" role="search" method="get" action="{{ path('app_index_search') }}">
                    <label for="search-query"></label>
                    <input id="search-query" class="form-control py-1" type="search" name="query" placeholder="{{ 'label.search'|trans }}..." required pattern=".{3,}" title="3 chars minimum" autocomplete="false" value="{{ app.request.get('query') }}">
                </form>
                <div class="d-flex navbar-cart">
                    {% set cartItems = app.session.get('cart')|length %}
                    <a href="{{ path('app_cart_index') }}" title="{{ 'cart.my-cart'|trans }} {{ cartItems }}">
                        <span {{ cartItems > 0 ? 'class="with-items"'}}>{{ cartItems }}</span>
                        {{ ea_ux_icon('bi:cart-fill', {class: 'basic-icon'}) }}
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>
    <main>{% block body %}{% endblock %}</main>

    <footer class="main-footer text-muted">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    {{ knp_menu_render('footer') }}
                </div>
                <div class="col-md-4">
                    <ul>
                        <li>
                            <a href="/de" title="Deutsch">
                                <img src="{{ asset('images/de.png') }}" alt="{{ app_name }} Logo" title="{{ app_name }}" width="32" height="32">
                                Deutsch
                            </a>
                        </li>
                        <li>
                            <a href="/en" title="English">
                                <img src="{{ asset('images/en.png') }}" alt="{{ app_name }} Logo" title="{{ app_name }}" width="32" height="32">
                                English
                            </a>
                        </li>
                    </ul>

                    <p class="copyright text-white">
                        <small>&copy; {{ "now"|date('Y') }} {{ 'copyright'|trans }}</small>
                    </p>
                </div>
                <div class="col-md-4 socials">
                    <a href="https://www.facebook.com/Rezouani-Leder-ImportExport-Berlin-401470737274935/" target="_blank">
                        {{ ea_ux_icon('bi:facebook', {class: 'basic-icon'}) }}
                    </a>
                </div>
            </div>
        </div>
    </footer>
</body>

</html>
