<div class="table-responsive">
    <h1 class="text-center mb-5">{{ h1_title }}</h1>
    <table class="table table-stripped table-hover">
        <thead>
        <tr>
            <th></th>
            <th></th>
            <th>{{ 'product.singular'|trans }}</th>
            <th>{{ 'product.color'|trans }}</th>
            <th>{{ 'product.size'|trans }}</th>
            <th>{{ 'product.quantity'|trans }}</th>
            <th>{{ 'purchase.price_unit'|trans }}</th>
            <th>{{ 'purchase.price_total'|trans }}</th>
            <th></th>
        </tr>
        </thead>

        <tbody>
        {% for itemKey,product in products %}
            <tr>
                <td>
                    {% if origin is defined and origin == 'cart' %}
                    <a href="{{ path('app_cart_remove', {'itemKey': itemKey}) }}" title="{{ 'label.delete'|trans }}" rel="nofollow" class="btn btn-danger">
                        {{ ux_icon('bi:trash-fill', {class: 'basic-icon'}) }}
                    </a>
                    {% endif %}
                </td>
                <td>
                    {% if product.image is defined %}
                        <img src="{{ asset('uploads/images/' ~ product.image) | imagine_filter('product_thumbnail') }}" alt="" width="120">
                    {% endif %}
                </td>
                <td nowrap="nowrap">
                    {% if product.image is defined %} <a href="{{ product.item_url }}">{{ product.title }}</a> {% endif %}
                    <p title="{{ 'label.message'|trans }}">
                        {% if product.message is defined and product.message is not empty %}
                            {{ ux_icon('bi:envelope-at', {class: 'basic-icon white-bg'}) }} {{ product.message }}
                        {% endif %}
                    </p>
                </td>
                <td>{{ ('product.colors_list.' ~ product.color)|trans }}</td>
                <td>{{ product.size|length > 0 ? product.size : '-' }}</td>
                <td>{{ product.quantity }}</td>
                <td>{{ (product.price / 100)|format_currency('EUR') }}</td>
                <td>{{ (product.full_price / 100)|format_currency('EUR') }}</td>
                <td></td>
            </tr>
        {% endfor %}
        </tbody>

        <tfoot>
            <tr>
                <td colspan="6"></td>
                <td class="font-weight-bold text-end">{{ 'purchase.total_excl_tax'|trans }}</td>
                <td>{{ (totals.excl_tax / 100)|format_currency('EUR') }}</td>
            </tr>
            <tr>
                <td colspan="6"></td>
                <td class="font-weight-bold text-end">{{ 'purchase.vat'|trans }}</td>
                <td>{{ (totals.vat / 100)|format_currency('EUR') }}</td>
            </tr>
            <tr>
                <td colspan="6"></td>
                <td class="font-weight-bold text-end">{{ 'purchase.total_incl_tax'|trans }}</td>
                <td>{{ (totals.total / 100)|format_currency('EUR') }}</td>
            </tr>
            {% if origin is defined and origin == 'cart' %}
            <tr>
                <td colspan="7"></td>
                <td colspan="2">
                    <div id="paypal-button-container"></div>
                    <script>
                        const locale = '{{ app.request.locale }}';
                        paypal.Buttons({
                            createOrder: () => {
                                return fetch('{{ path("app_purchase_create") }}', {
                                    method: 'POST'
                                })
                                    .then(res => res.json())
                                    .then(data => data.id);
                            },
                            onApprove: (data) => {
                                const orderId = data.orderID;
                                return fetch(`/${locale}/purchase/capture/${orderId}`, {
                                    method: 'POST'
                                })
                                    .then(res => res.json())
                                    .then(() => {
                                        console.log('Payment successful!');
                                        window.location.href = `/${locale}/purchase/complete/${orderId}`;
                                    });
                            }
                        }).render('#paypal-button-container');
                    </script>
                </td>
            </tr>
            {% endif %}
        </tfoot>
    </table>
</div>
