parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
           - message: '#Method App\\Controller\\Admin\\ProductCrudController::getRedirectResponseAfterSave\(\) has parameter \$context with generic class EasyCorp\\Bundle\\EasyAdminBundle\\Context\\AdminContext#'
    excludePaths:
    		- src/Command/ImportLegacyDataCommand.php
    		- config/reference.php

includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
