{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.4.1",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.6.1",
        "easycorp/easyadmin-bundle": "^4.28.0",
        "knplabs/knp-menu-bundle": "^3.7",
        "liip/imagine-bundle": "^2.17.1",
        "phpdocumentor/reflection-docblock": "^5.6.6",
        "phpstan/phpdoc-parser": "^2.3.2",
        "symfony/asset": "^8.0.4",
        "symfony/asset-mapper": "^8.0.4",
        "symfony/console": "^8.0.4",
        "symfony/doctrine-messenger": "^8.0.5",
        "symfony/dotenv": "^8.0",
        "symfony/expression-language": "^8.0.4",
        "symfony/flex": "^2.10",
        "symfony/form": "^8.0.4",
        "symfony/framework-bundle": "^8.0.5",
        "symfony/http-client": "^8.0.5",
        "symfony/intl": "^8.0.4",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0.5",
        "symfony/monolog-bundle": "^v4.0.1",
        "symfony/notifier": "^8.0.4",
        "symfony/process": "^8.0.5",
        "symfony/property-access": "^8.0.4",
        "symfony/property-info": "^8.0.5",
        "symfony/runtime": "^8.0.1",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0.5",
        "symfony/stimulus-bundle": "^2.32",
        "symfony/string": "^8.0.4",
        "symfony/translation": "^8.0.4",
        "symfony/twig-bundle": "^8.0.4",
        "symfony/ux-icons": "^2.32",
        "symfony/ux-turbo": "^2.32",
        "symfony/validator": "^8.0.5",
        "symfony/web-link": "^8.0.4",
        "symfony/yaml": "^8.0.1",
        "twig/extra-bundle": "^2.12|^3.23.0",
        "twig/intl-extra": "^3.23",
        "twig/twig": "^2.12|^3.23.0",
        "vich/uploader-bundle": "^2.9.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93.0",
        "phpstan/phpstan": "^2.1.37",
        "phpstan/phpstan-doctrine": "^2.0.14",
        "phpstan/phpstan-strict-rules": "^2.0.8",
        "phpunit/phpunit": "^12.5.8",
        "rector/rector": "^2.3.5",
        "symfony/browser-kit": "^8.0.4",
        "symfony/css-selector": "^8.0",
        "symfony/debug-bundle": "^8.0",
        "symfony/maker-bundle": "^1.65.1",
        "symfony/stopwatch": "^8.0",
        "symfony/web-profiler-bundle": "^8.0.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "static-code-check": [
            "@doctrine:schema-validate",
            "@doctrine:mapping-info",
            "@cs-fixer:check",
            "@phpstan:check",
            "@rector:check",
            "@phpunit"
        ],
        "doctrine:schema-validate": "php bin/console doctrine:schema:validate",
        "doctrine:mapping-info": "php bin/console doctrine:mapping:info",
        "cs-fixer:fix": "php vendor/bin/php-cs-fixer fix",
        "cs-fixer:check": "php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "phpstan:check": "phpstan analyse",
        "rector:check": "php vendor/bin/rector process --dry-run",
        "rector:fix": "php vendor/bin/rector process",
        "phpunit": "php bin/phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.0"
        }
    }
}
